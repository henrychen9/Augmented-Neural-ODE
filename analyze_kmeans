# ----------------------------
# pick closest points to centroid (no extra runs)
# ----------------------------

TOPK = 10
ONLY_NONFAILED = False   # set True if you want to ignore failed runs

for k in range(N_CLUSTERS):
    idx = np.where(cluster_ids == k)[0]

    if ONLY_NONFAILED:
        idx = idx[labels[idx] != "failed"]

    if len(idx) == 0:
        print(f"\nCluster {k}: no points (after filtering)")
        continue

    center = kmeans.cluster_centers_[k]  # centroid in PCA space
    dists = np.linalg.norm(X_pca[idx] - center, axis=1)

    order = np.argsort(dists)
    chosen = idx[order[:min(TOPK, len(idx))]]

    print(f"\nCluster {k}: closest {len(chosen)} runs to centroid (PCA-space distance)")
    print("  indices:", chosen.tolist())
    print("  labels :", [str(labels[i]) for i in chosen])
    print("  dists  :", [float(dists[order[j]]) for j in range(len(chosen))])

    # quick label summary for just these chosen ones
    counts = Counter(labels[chosen])
    print("  label counts among closest:", dict(counts))
